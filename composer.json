{
    "name": "atendwa/filament-page-guide",
    "description": "A \"Guide\" button and modal for Filament pages, showing a Blade view that explains the page.",
    "keywords": ["laravel", "filament", "filament-plugin", "help", "guide"],
    "homepage": "https://github.com/atendwa/filament-page-guide",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Tendwa",
            "homepage": "https://github.com/atendwa"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "nunomaduro/phpinsights": "^2.15",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Atendwa\\PageGuide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atendwa\\PageGuide\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atendwa\\PageGuide\\PageGuideServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint --parallel",
        "quality": [
            "pint --parallel --test",
            "rector --dry-run --no-diffs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
